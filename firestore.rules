rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'brendomdev@gmail.com' || 
        request.auth.token.email == 'Brendomdev@gmail.com' || 
        request.auth.token.email == 'brendomsiqueira96@gmail.com' ||
        request.auth.token.email == 'Brendomsiqueira96@gmail.com' ||
        request.auth.token.email == 'hardcoders@gmail.com' ||
        request.auth.token.email == 'Hardcoders@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Rules for USERS
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isOwner(userId) && 
                      (request.resource.data.role == 'user' || (request.resource.data.role == 'admin' && isAdmin())) && 
                      request.resource.data.email == request.auth.token.email &&
                      request.resource.data.uid == userId &&
                      request.resource.data.createdAt != null;
                      
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Rules for STUDENTS
    match /students/{studentId} {
      allow read, write: if isSignedIn();
    }

    // Rules for SCHOOL_USERS (Staff)
    match /school_users/{schoolUserId} {
      allow read, write: if isSignedIn();
    }

    // Rules for SUBJECTS
    match /subjects/{subjectId} {
      allow read, write: if isSignedIn();
    }

    // Rules for LESSONS
    match /lessons/{lessonId} {
      allow read, write: if isSignedIn();
    }

    // Rules for ASSESSMENTS
    match /assessments/{assessmentId} {
      allow read, write: if isSignedIn();
    }

    // Rules for GRADES
    match /grades/{gradeId} {
      allow read, write: if isSignedIn();
    }

    // Rules for ASSOCIATES
    match /associates/{associateId} {
      allow read: if isAdmin() || (isVerified() && resource.data.email == request.auth.token.email);
      allow create: if isAdmin() || (isVerified() && request.resource.data.email == request.auth.token.email);
      allow update: if isAdmin() || (isVerified() && resource.data.email == request.auth.token.email && request.resource.data.email == resource.data.email);
      allow delete: if isAdmin();
    }

    // Rules for DONATIONS
    match /donations/{donationId} {
      allow read, write: if isAdmin();
    }

    // Rules for MESSAGES (Feedback Board)
    match /messages/{messageId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
      
      allow create: if isAdmin() || (isSignedIn() && 
                      request.resource.data.senderId == request.auth.uid &&
                      request.resource.data.senderEmail == request.auth.token.email);
                      
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.senderId == request.auth.uid && 
        request.resource.data.senderId == resource.data.senderId &&
        request.resource.data.response == resource.data.response 
      );
      
      allow delete: if isAdmin();
    }
  }
}

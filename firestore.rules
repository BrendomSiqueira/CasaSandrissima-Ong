rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'brendomdev@gmail.com' || 
        request.auth.token.email == 'Brendomdev@gmail.com' || 
        request.auth.token.email == 'brendomsiqueira96@gmail.com' ||
        request.auth.token.email == 'Brendomsiqueira96@gmail.com' ||
        request.auth.token.email == 'hardcoders@gmail.com' ||
        request.auth.token.email == 'Hardcoders@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Rules for USERS
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin() || isSignedIn();
    }

    // Rules for STUDENTS
    match /students/{studentId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Rules for SCHOOL_USERS (Staff)
    match /school_users/{schoolUserId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Rules for SUBJECTS
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Rules for LESSONS
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Rules for ASSESSMENTS
    match /assessments/{assessmentId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Rules for GRADES
    match /grades/{gradeId} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

    // Rules for ASSOCIATES
    match /associates/{associateId} {
      allow read: if true;
      allow write: if isAdmin() || isVerified() || isSignedIn();
    }

    // Rules for DONATIONS
    match /donations/{donationId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    // Rules for MESSAGES (Feedback Board)
    match /messages/{messageId} {
      allow read: if true;
      allow write: if true;
    }

    // Rules for WORKSHOPS (Oficinas Comunitárias)
    match /workshops/{workshopId} {
      allow read: if true;
      allow write: if true;
    }

    // Rules for Test connection
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
